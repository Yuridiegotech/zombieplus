# Dockerfile.tests
# Imagem customizada para executar testes de regressão com Playwright
# Usa a imagem oficial do Playwright (já contém todas as libs necessárias) e adiciona Java 21 + Gradle.
FROM mcr.microsoft.com/playwright:latest

# Instala JDK 21 e Gradle (necessários para rodar a suite Gradle/Java)
RUN apt-get update && apt-get install -y openjdk-21-jdk gradle && rm -rf /var/lib/apt/lists/*

# Diretório de trabalho dentro do container
WORKDIR /src/tests

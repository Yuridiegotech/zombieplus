# Dockerfile.tests
# Imagem customizada para executar testes de regressão com Playwright
# Usa a imagem oficial do Playwright e adiciona Java 21 + Gradle + curl + socat + xvfb.
FROM mcr.microsoft.com/playwright:v1.53.1-jammy

# Instala JDK 21, Gradle, curl, socat e xvfb (para suporte a headed browser em container)
RUN apt-get update && apt-get install -y openjdk-21-jdk gradle curl socat xvfb && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Diretório de trabalho dentro do container
WORKDIR /src/tests
